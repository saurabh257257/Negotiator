# Copy this file to .env and fill in the values. Never commit .env.

# From the Zoho API Console (Server-based Application). See README.md.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Default Zoho data center shown on the connect page: in, com, eu, au, jp, ca, sa, ae
ZOHO_DC=in

# Must match the redirect URI registered in the Zoho API Console exactly
ZOHO_REDIRECT_URI=http://localhost:5055/oauth/callback

# Demo login: the only mobile number accepted. Set AUTH_DEMO=0 to disable (real OTP login is not built yet).
AUTH_DEMO=1
DEMO_MOBILE=123

# Seconds between Zoho API calls (Zoho allows 100 requests/minute per organization)
ZOHO_MIN_INTERVAL=0.7
